#!/bin/bash
set -euo pipefail
CONTENTS="$(cd "$(dirname "$0")/.." && pwd)"
SUPPORT="$CONTENTS/SharedSupport"
export WINEPREFIX="$SUPPORT/prefix"
export DYLD_FALLBACK_LIBRARY_PATH="$CONTENTS/Frameworks:/usr/lib"
export WINEDEBUG=-all
export WINEMSYNC=1
export WINEDLLPATH_D9VK="$SUPPORT/renderer/d9vk/wine"
export VK_DRIVER_FILES="$CONTENTS/Resources/vulkan/icd.d/kosmickrisp_mesa_icd.json"
export DXVK_LOG_PATH="$SUPPORT/Logs"
export DOTNET_SYSTEM_GLOBALIZATION_USENLS=1
export WINEDLLOVERRIDES="msvcp140,msvcp140_1,msvcp140_2,msvcp140_atomic_wait,vcruntime140,icu=n;d3d8,d3d9=b"
export PATH="$SUPPORT/wine/bin:/usr/bin:/bin:/usr/sbin:/sbin"
GAME_DIR="$SUPPORT/GameFiles"
[ -f "$GAME_DIR/GeneralsOnlineZH.exe" ]
[ -x "$SUPPORT/wine/bin/wine" ]
[ -f "$WINEPREFIX/drive_c/Program Files (x86)/dotnet/dotnet.exe" ]
PYTHON=/opt/homebrew/bin/python3; [ -x "$PYTHON" ] || PYTHON=/usr/bin/python3
"$PYTHON" "$CONTENTS/Resources/refresh-launcher.py" "$GAME_DIR"
if [ "${1:-}" = --check ]; then printf 'Game and GeneralsOnline launcher are ready.\n'; exit 0; fi
mkdir -p "$SUPPORT/Logs"
LOCK="$SUPPORT/Logs/game.lock"
if ! mkdir "$LOCK" 2>/dev/null; then
 PREVIOUS_PID=$(cat "$LOCK/pid" 2>/dev/null || true)
 if [[ "$PREVIOUS_PID" =~ ^[0-9]+$ ]] && kill -0 "$PREVIOUS_PID" 2>/dev/null; then exit 0; fi
 rm -f "$LOCK/pid"
 rmdir "$LOCK" 2>/dev/null || exit 0
 mkdir "$LOCK"
fi
echo $$ > "$LOCK/pid"
trap 'rm -f "$LOCK/pid"; rmdir "$LOCK" 2>/dev/null || true' EXIT
exec >"$SUPPORT/Logs/launch.log" 2>&1
cd "$GAME_DIR"
if [ "${1:-}" = --windowed ]; then
 DISPLAY_ARGS=(-win -xres 1280 -yres 800)
else
 read -r DESKTOP_WIDTH DESKTOP_HEIGHT < <("$CONTENTS/Resources/screen-size")
 DISPLAY_ARGS=(-fullscreen -xres "$DESKTOP_WIDTH" -yres "$DESKTOP_HEIGHT")
fi
"$SUPPORT/wine/bin/wine" 'C:\Program Files (x86)\dotnet\dotnet.exe' 'C:\Games\Zero Hour\Launcher.dll' "${DISPLAY_ARGS[@]}"

@@ -1362,6 +1362,27 @@
     - (CGPoint) nokcanduMacMousePoint:(CGPoint)point
     {
         return cgpoint_mac_from_win_global(point);
+    }
+
+    /* Button-only delivery preserves Wine's current cursor, including
+       relative movement inside a scaled virtual desktop. No Mac warp. */
+    - (BOOL) nokcanduPostControllerButton:(int)button pressed:(BOOL)pressed
+    {
+        static WineWindow* held[5];
+        if (button < 0 || button > 4) return NO;
+        WineWindow* window = pressed ? (WineWindow*)[NSApp keyWindow] : held[button];
+        if (![window isKindOfClass:[WineWindow class]] || (pressed && held[button])) return NO;
+        macdrv_event* event = macdrv_create_event(MOUSE_BUTTON, window);
+        if (!event) return NO;
+        event->mouse_button.button = -button - 1;
+        event->mouse_button.pressed = pressed;
+        event->mouse_button.x = event->mouse_button.y = 0;
+        event->mouse_button.time_ms = [self ticksForEventTime:[[NSProcessInfo processInfo] systemUptime]];
+        if (pressed) held[button] = [window retain];
+        [window.queue postEvent:event];
+        macdrv_release_event(event);
+        if (!pressed) { [held[button] release]; held[button] = nil; }
+        return YES;
     }
 

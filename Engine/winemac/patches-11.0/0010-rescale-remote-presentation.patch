+    }
+
+    /* Virtual-screen resizing changes Cocoa scale without changing Windows geometry. Remote
+     * layers are not NSView subviews, so the existing view/Metal relayout cannot resize them.
+     * Keep the remote content's pixel bounds and transform every hosted child to its new target. */
+    - (void) presentRescaleCALayerHostsBy:(double)ratio
+    {
+        if (!present_on || ratio <= 0 || fabs(ratio - 1.0) < 1e-9) return;
+        [CATransaction begin];
+        [CATransaction setDisableActions:YES];
+        for (NSNumber* key in _caLayerHosts)
+        {
+            NSValue* stored = [_caLayerHostTargetFrames objectForKey:key];
+            if (!stored) continue;
+            CGRect frame = stored.rectValue;
+            frame.origin.x *= ratio; frame.origin.y *= ratio;
+            frame.size.width *= ratio; frame.size.height *= ratio;
+            [self placeCALayerHost:[_caLayerHosts objectForKey:key] contextId:key.unsignedIntValue frame:frame];
+        }
+        [CATransaction commit];
     }
 

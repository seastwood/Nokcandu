+/* Nokcandu on MetalSharp (Apple silicon): the table MetalSharp's WineMetalGL looks for (dlsym "macdrv_functions"),
+ * with Wine 11's own window data (hwnd, cocoa_window, client_view first, as it reads it). With it, a game's OpenGL
+ * picture is a metal view in Wine's client view, which the resizable window scales with the window; without it,
+ * WineMetalGL places a view of its own from Win32 coordinates, which don't match a scaled window. */
+struct wmgl_macdrv_functions_t
+{
+    void (*macdrv_init_display_devices)(BOOL);
+    struct macdrv_win_data *(*get_win_data)(HWND hwnd);
+    void (*release_win_data)(struct macdrv_win_data *data);
+    WineWindow *(*macdrv_get_cocoa_window)(HWND hwnd, BOOL require_on_screen);
+    MTLDevice_id (*macdrv_create_metal_device)(void);
+    void (*macdrv_release_metal_device)(MTLDevice_id d);
+    WineMetalView *(*macdrv_view_create_metal_view)(WineContentView *v, MTLDevice_id d);
+    CAMetalLayer *(*macdrv_view_get_metal_layer)(WineMetalView *v);
+    void (*macdrv_view_release_metal_view)(WineMetalView *v);
+    void (*on_main_thread)(dispatch_block_t b);
+};
+
+static void wmgl_init_display_devices(BOOL force)
+{
+}
+
+/* The client area in the top-level window's view, as Wine's client surfaces place theirs. */
+static CGRect wmgl_client_frame(const struct macdrv_win_data *data)
+{
+    RECT r = data->rects.client;
+    OffsetRect(&r, -data->rects.visible.left, -data->rects.visible.top);
+    return cgrect_from_rect(r);
+}
+
+/* A top-level window without a client view gets one (as a client surface would make), so the renderer has a view
+ * that the driver keeps placed and scaled; it follows the client area in macdrv_WindowPosChanged. */
+static struct macdrv_win_data *wmgl_get_win_data(HWND hwnd)
+{
+    struct macdrv_win_data *data;
+    WineContentView *view;
+    CGRect frame;
+    const char *off = getenv("NOKCANDU_WMGL_OWN_VIEW");
+
+    if (off && *off == '1') return NULL;   /* testing: WineMetalGL places a view of its own */
+    data = get_win_data(hwnd);
+
+    if (!data || data->client_view || !data->cocoa_window || NtUserGetAncestor(hwnd, GA_ROOT) != hwnd) return data;
+    frame = wmgl_client_frame(data);
+    release_win_data(data);
+
+    view = macdrv_create_view(frame);
+    if (!(data = get_win_data(hwnd))) { macdrv_dispose_view(view); return NULL; }
+    if (data->client_view || !data->cocoa_window) { macdrv_dispose_view(view); return data; }
+    macdrv_set_view_superview(view, NULL, data->cocoa_window, NULL, NULL);
+    macdrv_set_view_frame(view, wmgl_client_frame(data));
+    macdrv_set_view_hidden(view, FALSE);
+    data->client_view = view;
+    data->nokcandu_client_view = view;
+    TRACE("win %p: client view %p for an outside renderer\n", hwnd, view);
+    return data;
+}
+
+static void wmgl_release_win_data(struct macdrv_win_data *data)
+{
+    if (data) release_win_data(data);
+}
+
+static WineWindow *wmgl_get_cocoa_window(HWND hwnd, BOOL require_on_screen)
+{
+    return macdrv_get_cocoa_window(hwnd, require_on_screen);
+}
+
+static void wmgl_on_main_thread(dispatch_block_t b)
+{
+    OnMainThread(b);
+}
+
+DECLSPEC_EXPORT struct wmgl_macdrv_functions_t macdrv_functions =
+{
+    wmgl_init_display_devices,
+    wmgl_get_win_data,
+    wmgl_release_win_data,
+    wmgl_get_cocoa_window,
+    macdrv_create_metal_device,
+    macdrv_release_metal_device,
+    macdrv_view_create_metal_view,
+    macdrv_view_get_metal_layer,
+    macdrv_view_release_metal_view,
+    wmgl_on_main_thread,
+};
+
+#endif

+/***********************************************************************
+ *              macdrv_present_start
+ *
+ * Starts windowed presentation with a virtual desktop of the given size: shown at about three quarters of the
+ * main screen, centred, keeping the desktop's shape.
+ */
+void macdrv_present_start(int requested_width, int requested_height)
+{
+    int fw, fh;
+
+    /* The virtual monitor's current mode is shared by all of the game's processes (Wine's desktop process
+       re-reads it too): the first one starts it at the chosen resolution, later ones join it. Each holds a
+       shared lock for its lifetime, so "first" means no other process of this prefix is presenting. */
+    present_paths();
+    present_lock_fd = open(present_lock_path, O_RDWR | O_CREAT | O_CLOEXEC, 0644);
+    if (present_lock_fd >= 0 && !flock(present_lock_fd, LOCK_EX | LOCK_NB))
+    {
+        if (requested_width > 0 && requested_height > 0)
+            present_write_mode(requested_width, requested_height);
+        else if (present_read_mode(&fw, &fh))
+        {
+            /* Automatic: start at the resolution the game used last time. */
+            requested_width = fw;
+            requested_height = fh;
+        }
+        flock(present_lock_fd, LOCK_SH);
+    }
+    else
+    {
+        if (present_lock_fd >= 0) flock(present_lock_fd, LOCK_SH);
+        if (present_read_mode(&fw, &fh))
+        {
+            requested_width = fw;
+            requested_height = fh;
+        }
+    }
+
+    OnMainThread(^{
+        int width = requested_width, height = requested_height;
+        NSScreen *screen = [NSScreen screens].firstObject;
+        NSRect visible = screen.visibleFrame, full = screen.frame;
+        double s;
+
+        if (width <= 0 || height <= 0)
+        {
+            width = NSWidth(full);
+            height = NSHeight(full);
+        }
+        s = fmin(NSWidth(visible) * 0.75 / width, NSHeight(visible) * 0.75 / height);
+        present_desktop = CGSizeMake(width, height);
+        present_scale = s;
+        present_user_scale = s;
+        /* Centre in the visible area (Cocoa bottom-left -> global top-left). */
+        present_origin.x = round(NSMidX(visible) - width * s / 2);
+        present_origin.y = round((NSMaxY(full) - NSMaxY(visible)) + (NSHeight(visible) - height * s) / 2);
+        present_on = TRUE;
+        [[WineApplicationController sharedController] applicationDidChangeScreenParameters:nil];
+    });
+}
+
+/***********************************************************************
+ *              macdrv_present_set_desktop_size
+ *
+ * The game switched resolution: the virtual monitor takes the new size (for all the game's processes).
+ */
+void macdrv_present_set_desktop_size(int width, int height)
+{
+    if (!present_on || width <= 0 || height <= 0) return;
+    present_write_mode(width, height);
+    OnMainThread(^{ present_resize(width, height); });
+}
+
+/***********************************************************************
+ *              macdrv_present_sync
+ *
+ * Another of the game's processes may have changed the virtual monitor's mode: follow it.
+ */
+void macdrv_present_sync(void)
+{
+    int w, h;
+
+    if (!present_on || !present_read_mode(&w, &h)) return;
+    if (w == (int)present_desktop.width && h == (int)present_desktop.height) return;
+    OnMainThread(^{
+        if (w != (int)present_desktop.width || h != (int)present_desktop.height)
+            present_resize(w, h);
+    });
+}
+
+/***********************************************************************
+ *              macdrv_present_frames_changed
+ *
+ * The desktop picture moved or was rescaled: forget cached screen frames and mouse baselines.
+ */
+void macdrv_present_frames_changed(void)
+{
+    WineApplicationController* controller = [WineApplicationController sharedController];
+    [controller presentFramesChanged];
+}

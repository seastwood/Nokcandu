+/* Nokcandu: the virtual monitor's mode, shared between the game's processes through a small file in the
+ * prefix ("WxH"). */
+static char present_mode_path[1024], present_lock_path[1100], present_scale_path[1100];
+static int present_lock_fd = -1;
+
+/* Diagnostics: with a file named .nokcandu-debug in the prefix, the driver logs its presentation decisions. */
+int present_debug = -1;
+void present_log(const char *fmt, ...)
+{
+    va_list args;
+    if (present_debug < 0)
+    {
+        char path[1100];
+        const char *prefix = getenv("WINEPREFIX");
+        snprintf(path, sizeof(path), "%s/.nokcandu-debug", prefix ? prefix : "/nonexistent");
+        present_debug = access(path, F_OK) == 0;
+    }
+    if (!present_debug) return;
+    va_start(args, fmt);
+    fprintf(stderr, "nokcandu-present[%d]: ", (int)getpid());
+    vfprintf(stderr, fmt, args);
+    fputc('\n', stderr);
+    va_end(args);
+}
+
+static void present_paths(void)
+{
+    const char *prefix = getenv("WINEPREFIX"), *home = getenv("HOME");
+    char fallback[1024];
+
+    if (!prefix || !*prefix)
+    {
+        snprintf(fallback, sizeof(fallback), "%s/.wine", home ? home : "/tmp");
+        prefix = fallback;
+    }
+    snprintf(present_mode_path, sizeof(present_mode_path), "%s/.nokcandu-virtual-display", prefix);
+    snprintf(present_lock_path, sizeof(present_lock_path), "%s.lock", present_mode_path);
+    snprintf(present_scale_path, sizeof(present_scale_path), "%s/.nokcandu-window-scale", prefix);
+}
+
+/* The size the user last gave the game's window, as a scale (Mac points per game pixel), kept in the prefix so
+   the game opens at that size next time (and its other windows, e.g. a menu window, show at the same scale). */
+static double present_read_scale(void)
+{
+    FILE *f;
+    double v = 0;
+
+    double w = 0;
+
+    if (!present_scale_path[0] || !(f = fopen(present_scale_path, "r"))) return 0;
+    if (fscanf(f, "%lf %lf", &v, &w) < 1) v = 0;
+    fclose(f);
+    if (w >= 0.1 && w <= 8) present_window_scale = w;
+    return (v >= 0.1 && v <= 8) ? v : 0;
+}
+
+void macdrv_present_save_user_scale(void)
+{
+    char tmp[1200];
+    FILE *f;
+
+    if (!present_on || !present_scale_path[0] || present_user_scale < 0.1) return;
+    snprintf(tmp, sizeof(tmp), "%s.%d", present_scale_path, (int)getpid());
+    if (!(f = fopen(tmp, "w"))) return;
+    fprintf(f, "%.6f %.6f\n", present_user_scale, present_window_scale);
+    fclose(f);
+    rename(tmp, present_scale_path);
+}
+
+static void present_write_mode(int width, int height)
+{
+    char tmp[1100];
+    FILE *f;
+
+    if (!present_mode_path[0]) return;
+    snprintf(tmp, sizeof(tmp), "%s.%d", present_mode_path, (int)getpid());
+    if (!(f = fopen(tmp, "w"))) return;
+    fprintf(f, "%dx%d\n", width, height);
+    fclose(f);
+    rename(tmp, present_mode_path);
+}
+
+static BOOL present_read_mode(int *width, int *height)
+{
+    FILE *f;
+    int w = 0, h = 0, n;
+
+    if (!present_mode_path[0] || !(f = fopen(present_mode_path, "r"))) return FALSE;
+    n = fscanf(f, "%dx%d", &w, &h);
+    fclose(f);
+    if (n != 2 || w < 1 || h < 1 || w > 16384 || h > 16384) return FALSE;
+    *width = w;
+    *height = h;
+    return TRUE;
+}
+
+/* Whether the picture itself is the window in Mac full screen. */
+static BOOL present_on_picture_fullscreen(void)
+{
+    for (NSWindow* w in [NSApp windows])
+        if ([w isKindOfClass:[WineWindow class]] && [(WineWindow*)w isPresentedWindow] &&
+            ([w styleMask] & NSWindowStyleMaskFullScreen))
+            return TRUE;
+    return FALSE;
+}
+
+/* Resizes the virtual monitor (main thread). */
+static void present_resize(int width, int height)
+{
+        double old_scale = present_scale;
+        CGPoint old_origin = present_origin;
+        CGRect old_rect = present_rect();
+        NSScreen *screen = [NSScreen screens].firstObject;
+        NSRect full = screen.frame, visible = screen.visibleFrame;
+        CGRect area;   /* where the picture may go, Mac global top-left coordinates */
+        double s;
+
+        if (!present_on || width <= 0 || height <= 0) return;
+        if (present_fullscreen)
+        {
+            /* Full screen: as big as the screen allows, centred (black bars around). */
+            double notch = 0;
+            if (@available(macOS 12.0, *)) notch = screen.safeAreaInsets.top;   /* full screen sits below it */
+            area = CGRectMake(NSMinX(full), notch, NSWidth(full), NSHeight(full) - notch);
+            s = fmin(area.size.width / width, area.size.height / height);
+        }
+        else
+        {
+            /* Same scale as the user chose, like a monitor: more pixels make a bigger window, never larger than
+               the screen. Always from the user's scale, so changing modes back and forth doesn't shrink it. */
+            area = CGRectMake(NSMinX(visible), NSMaxY(full) - NSMaxY(visible), NSWidth(visible), NSHeight(visible) - 28);
+            s = fmin(present_user_scale, fmin(area.size.width / width, area.size.height / height));
+        }
+        present_desktop = CGSizeMake(width, height);
+        present_scale = s;
+        if (present_fullscreen)
+            present_origin = CGPointMake(round(CGRectGetMidX(area) - width * s / 2), round(CGRectGetMidY(area) - height * s / 2));
+        else
+        {
+            /* Keep the window's top-left corner, nudged back on screen (title bar below the menu bar). */
+            double x = old_rect.origin.x, y = old_rect.origin.y;
+            x = fmax(area.origin.x, fmin(x, CGRectGetMaxX(area) - width * s));
+            y = fmax(area.origin.y + 28, fmin(y, area.origin.y + 28 + area.size.height - height * s));
+            present_origin = CGPointMake(x, y);
+        }
+        macdrv_present_relayout(old_scale, old_origin);
+        if (!present_on_picture_fullscreen())
+        {
+            for (NSWindow* w in [NSApp windows])
+                if ([w isKindOfClass:[WineWindow class]] && ![(WineWindow*)w isPresentedWindow])
+                    [(WineWindow*)w presentRefit];
+        }
+        [[WineApplicationController sharedController] applicationDidChangeScreenParameters:nil];
+}
+
+/***********************************************************************
+ *              macdrv_present_start
+ *
+ * Starts windowed presentation with a virtual desktop of the given size: shown at about three quarters of the
+ * main screen, centred, keeping the desktop's shape.
+ */
+void macdrv_present_start(int requested_width, int requested_height)
+{
+    int fw, fh;
+
+    /* The virtual monitor's current mode is shared by all of the game's processes (Wine's desktop process
+       re-reads it too): the first one starts it at the chosen resolution, later ones join it. Each holds a
+       shared lock for its lifetime, so "first" means no other process of this prefix is presenting. */
+    present_paths();
+    present_lock_fd = open(present_lock_path, O_RDWR | O_CREAT | O_CLOEXEC, 0644);
+    if (present_lock_fd >= 0 && !flock(present_lock_fd, LOCK_EX | LOCK_NB))
+    {
+        if (requested_width > 0 && requested_height > 0)
+            present_write_mode(requested_width, requested_height);
+        else if (present_read_mode(&fw, &fh))
+        {
+            /* Automatic: start at the resolution the game used last time. */
+            requested_width = fw;
+            requested_height = fh;
+        }
+        flock(present_lock_fd, LOCK_SH);
+    }
+    else
+    {
+        if (present_lock_fd >= 0) flock(present_lock_fd, LOCK_SH);
+        if (present_read_mode(&fw, &fh))
+        {
+            requested_width = fw;
+            requested_height = fh;
+        }
+    }
+
+    OnMainThread(^{
+        int width = requested_width, height = requested_height;
+        NSScreen *screen = [NSScreen screens].firstObject;
+        NSRect visible = screen.visibleFrame, full = screen.frame;
+        double s;
+
+        if (width <= 0 || height <= 0)
+        {
+            width = NSWidth(full);
+            height = NSHeight(full);
+        }
+        /* The size the user chose last time, else one game pixel per point (a game's own window opens at its
+           natural size); never bigger than nine tenths of the screen. */
+        s = present_read_scale();
+        if (s <= 0) s = 1;
+        s = fmin(s, fmin(NSWidth(visible) * 0.9 / width, (NSHeight(visible) - 28) * 0.9 / height));
+        present_desktop = CGSizeMake(width, height);
+        present_scale = s;
+        present_user_scale = s;
+        /* Centre in the visible area (Cocoa bottom-left -> global top-left). */
+        present_origin.x = round(NSMidX(visible) - width * s / 2);
+        present_origin.y = round((NSMaxY(full) - NSMaxY(visible)) + (NSHeight(visible) - height * s) / 2);
+        present_on = TRUE;
+        [[WineApplicationController sharedController] applicationDidChangeScreenParameters:nil];
+
+        /* Follow resolution changes made while the game runs (in Nokcandu, or by another of the game's processes)
+           even when nothing asks for the displays: check the shared mode file twice a second (a stat, cheap). */
+        static dispatch_source_t present_watch;
+        if (!present_watch)
+        {
+            present_watch = dispatch_source_create(DISPATCH_SOURCE_TYPE_TIMER, 0, 0, dispatch_get_main_queue());
+            dispatch_source_set_timer(present_watch, dispatch_time(DISPATCH_TIME_NOW, NSEC_PER_SEC / 2),
+                                      NSEC_PER_SEC / 2, NSEC_PER_SEC / 10);
+            dispatch_source_set_event_handler(present_watch, ^{ macdrv_present_sync(); });
+            dispatch_resume(present_watch);
+        }
+    });
+}

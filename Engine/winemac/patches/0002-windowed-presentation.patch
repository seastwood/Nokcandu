+/***********************************************************************
+ *              macdrv_present_set_desktop_size
+ *
+ * The game switched resolution: the virtual monitor takes the new size (for all the game's processes).
+ */
+void macdrv_present_set_desktop_size(int width, int height)
+{
+    if (!present_on || width <= 0 || height <= 0) return;
+    present_write_mode(width, height);
+    if ([NSThread isMainThread]) present_resize(width, height);    /* e.g. from a window frame change */
+    else OnMainThreadAsync(^{ present_resize(width, height); });
+}
+
+/***********************************************************************
+ *              macdrv_present_sync
+ *
+ * Another of the game's processes may have changed the virtual monitor's mode: follow it.
+ */
+void macdrv_present_sync(void)
+{
+    static struct timespec last_mtime;
+    static off_t last_size = -1;
+    struct stat st;
+    int w, h;
+
+    if (!present_on) return;
+    /* Called whenever displays are queried (some renderers ask every frame): only read the file when it changed. */
+    if (stat(present_mode_path, &st)) return;
+    if (st.st_size == last_size && st.st_mtimespec.tv_sec == last_mtime.tv_sec &&
+        st.st_mtimespec.tv_nsec == last_mtime.tv_nsec)
+        return;
+    last_mtime = st.st_mtimespec;
+    last_size = st.st_size;
+    if (!present_read_mode(&w, &h)) return;
+    if (w == (int)present_desktop.width && h == (int)present_desktop.height) return;
+    /* Called on the main thread by the watch timer: OnMainThread from the main thread would wait on itself. */
+    if ([NSThread isMainThread])
+    {
+        present_resize(w, h);
+        return;
+    }
+    OnMainThreadAsync(^{
+        if (w != (int)present_desktop.width || h != (int)present_desktop.height)
+            present_resize(w, h);
+    });
+}
+
+/***********************************************************************
+ *              macdrv_present_frames_changed
+ *
+ * The desktop picture moved or was rescaled: forget cached screen frames and mouse baselines.
+ */
+/* Frees the mouse (as Shift-Cmd-Esc does), e.g. for a question the user must answer. */
+void macdrv_present_release_mouse(void)
+{
+    [[WineApplicationController sharedController] presentSetReleased:TRUE];
+}
+
+void macdrv_present_frames_changed(void)
+{
+    WineApplicationController* controller = [WineApplicationController sharedController];
+    [controller presentFramesChanged];
+}

+/***********************************************************************
+ *              macdrv_present_relayout
+ *
+ * Nokcandu: the desktop picture moved or was rescaled (present_origin and present_scale are already new). Every
+ * window keeps its Win32 position; its Mac frame and its views follow.
+ */
+void macdrv_present_relayout(double old_scale, CGPoint old_origin)
+{
+    if (old_scale <= 0) return;
+    present_relayout_depth++;
+    for (NSWindow* window in [NSApp windows])
+    {
+        if ([window isKindOfClass:[WineWindow class]])
+            [(WineWindow*)window presentRelayoutFromScale:old_scale origin:old_origin];
+    }
+    present_relayout_depth--;
+    macdrv_present_frames_changed();
+}

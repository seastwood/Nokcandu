+/* Nokcandu: the virtual monitor's modes. Any size works; these are the ones games look for. */
+static const struct { int w, h; } present_sizes[] =
+{
+    {640, 480}, {720, 480}, {800, 600}, {1024, 768}, {1152, 864}, {1280, 720}, {1280, 800}, {1280, 960},
+    {1280, 1024}, {1360, 768}, {1366, 768}, {1440, 900}, {1600, 900}, {1600, 1200}, {1680, 1050},
+    {1920, 1080}, {1920, 1200}, {2048, 1152}, {2560, 1080}, {2560, 1440}, {2560, 1600}, {3440, 1440},
+    {3840, 2160},
+};
+
+static void present_devmode(DEVMODEW *devmode, int w, int h, int bpp)
+{
+    devmode->dmDisplayOrientation = DMDO_DEFAULT;
+    devmode->dmDisplayFixedOutput = DMDFO_DEFAULT;
+    devmode->dmBitsPerPel = bpp;
+    devmode->dmPelsWidth = w;
+    devmode->dmPelsHeight = h;
+    devmode->dmDisplayFlags = 0;
+    devmode->dmDisplayFrequency = 60;
+    devmode->dmFields |= DM_DISPLAYORIENTATION | DM_DISPLAYFIXEDOUTPUT | DM_BITSPERPEL | DM_PELSWIDTH |
+                         DM_PELSHEIGHT | DM_DISPLAYFLAGS | DM_DISPLAYFREQUENCY;
+}
+
+static DEVMODEW *present_get_modes(int *modes_count)
+{
+    static const int bpps[] = {32, 16, 8};
+    int sizes = ARRAY_SIZE(present_sizes) + 1, count = 0, i, b;
+    DEVMODEW *devmodes = calloc(sizes * ARRAY_SIZE(bpps), sizeof(DEVMODEW));
+    int cw = present_desktop.width, ch = present_desktop.height;
+    BOOL have_current = FALSE;
+
+    if (!devmodes) return NULL;
+    for (i = 0; i < ARRAY_SIZE(present_sizes); i++)
+        if (present_sizes[i].w == cw && present_sizes[i].h == ch) have_current = TRUE;
+
+    for (b = 0; b < ARRAY_SIZE(bpps); b++)
+    {
+        for (i = 0; i < sizes; i++)
+        {
+            int w, h;
+            if (i < ARRAY_SIZE(present_sizes)) { w = present_sizes[i].w; h = present_sizes[i].h; }
+            else if (!have_current) { w = cw; h = ch; }
+            else continue;
+            devmodes[count].dmSize = sizeof(DEVMODEW);
+            present_devmode(devmodes + count, w, h, bpps[b]);
+            count++;
+        }
+    }
+    *modes_count = count;
+    return devmodes;
+}

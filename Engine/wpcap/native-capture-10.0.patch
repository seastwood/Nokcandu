+static NTSTATUS wrap_wait_packet( void *args )
+{
+    const UINT64 *handle = args;
+    struct pollfd fd = { pcap_get_selectable_fd( (pcap_t *)(ULONG_PTR)*handle ), POLLIN, 0 };

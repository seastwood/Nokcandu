+/***********************************************************************
+ *              CM_Get_Parent (SETUPAPI.@)
+ */
+CONFIGRET WINAPI CM_Get_Parent(PDEVINST result, DEVINST node, ULONG flags)
+{
+    WCHAR parent[MAX_DEVICE_ID_LEN];
+    DEVPROPTYPE type;
+    ULONG size = sizeof(parent);
+    CONFIGRET ret;
+
+    if (!result) return CR_INVALID_POINTER;
+    *result = 0;
+    if (flags) return CR_INVALID_FLAG;
+    ret = CM_Get_DevNode_PropertyW(node, &DEVPKEY_Device_Parent, &type, (BYTE *)parent, &size, 0);
+    if (ret == CR_NO_SUCH_VALUE) return CR_NO_SUCH_DEVNODE;
+    if (ret != CR_SUCCESS) return ret;
+    if (type != DEVPROP_TYPE_STRING || size < sizeof(WCHAR) || size > sizeof(parent) ||
+        size % sizeof(WCHAR) || parent[size / sizeof(WCHAR) - 1] || !parent[0]) return CR_INVALID_DATA;
+    return CM_Locate_DevNodeW(result, parent, 0);
+}
